#. Plugin Name of the plugin
#: osec-addon-contributors.php
msgid "Contributors Add-on for Open Source Event Calendar"
msgstr "Contributors Add-on für Open Source Event Calendar"

#. Plugin URI of the plugin
#: osec-addon-contributors.php
msgid "https://github.com/digitaldonkey/osec-addon-contributors"
msgstr ""

#. Description of the plugin
#: osec-addon-contributors.php
msgid "Lets registered users draft events with images for review: own events and media only in the admin, private images until the event is published, and an Event Publisher role."
msgstr "Registrierte Benutzer entwerfen Veranstaltungen mit Bildern zur Prüfung: nur eigene Veranstaltungen und Medien im Admin-Bereich, private Bilder bis zur Veröffentlichung und eine Rolle „Event Publisher“."

#. Author of the plugin
#: osec-addon-contributors.php
msgid "digitaldonkey"
msgstr ""

#. Author URI of the plugin
#: osec-addon-contributors.php
msgid "https://donkeymedia.eu"
msgstr ""

#: src/Admin/AdminMenu.php:55
msgid "My events"
msgstr "Meine Veranstaltungen"

#. translators: 1: folder path, 2: nginx rule
#: src/PrivateUploads/StorageCheck.php:179
#, php-format
msgid "Contributors Add-on: private images are stored in %1$s, but the web server delivers files from there to anyone. Image uploads of event contributors are paused. On nginx, add this rule to the server configuration (Apache is handled automatically), or define OSEC_ADDON_CONTRIBUTORS_PRIVATE_DIR as a folder outside the web root: %2$s"
msgstr "Contributors Add-on: Private Bilder liegen in %1$s, aber der Webserver liefert Dateien von dort an jeden aus. Bild-Uploads von Veranstaltungs-Mitwirkenden sind pausiert. Füge bei nginx diese Regel zur Server-Konfiguration hinzu (Apache wird automatisch abgedeckt) oder setze OSEC_ADDON_CONTRIBUTORS_PRIVATE_DIR auf einen Ordner außerhalb des Web-Verzeichnisses: %2$s"

#: src/PrivateUploads/StorageCheck.php:200
msgid "Private event images"
msgstr "Private Veranstaltungsbilder"

#: src/PrivateUploads/StorageCheck.php:216
msgid "Private event images cannot be downloaded directly"
msgstr "Private Veranstaltungsbilder können nicht direkt heruntergeladen werden"

#: src/PrivateUploads/StorageCheck.php:218
msgid "Private event images can be downloaded by anyone"
msgstr "Private Veranstaltungsbilder können von jedem heruntergeladen werden"

#: src/PrivateUploads/StorageCheck.php:222
msgid "Security"
msgstr "Sicherheit"

#. translators: %s: folder path
#: src/PrivateUploads/StorageCheck.php:227
#, php-format
msgid "Images of unpublished events are stored in %s."
msgstr "Bilder unveröffentlichter Veranstaltungen liegen in %s."

#: src/PrivateUploads/UploadRouter.php:51
msgid "Image uploads are paused until an administrator secures the storage for private images."
msgstr "Bild-Uploads sind pausiert, bis ein Administrator den Speicher für private Bilder abgesichert hat."

#: src/PrivateUploads/UrlFilter.php:105
msgid "Invalid post ID."
msgstr "Ungültige Beitrags-ID."

#. translators: %s: folder path
#: src/PrivateUploads/StorageCheck.php:162
#, php-format
msgid "Contributors Add-on: the folder for private images, %s, cannot be created or written by the web server. Image uploads of event contributors are paused. Make it writable, or define OSEC_ADDON_CONTRIBUTORS_PRIVATE_DIR as a writable folder outside the web root."
msgstr "Contributors Add-on: Der Ordner für private Bilder, %s, kann vom Webserver nicht angelegt oder beschrieben werden. Bild-Uploads von Veranstaltungs-Mitwirkenden sind pausiert. Mache ihn beschreibbar oder setze OSEC_ADDON_CONTRIBUTORS_PRIVATE_DIR auf einen beschreibbaren Ordner außerhalb des Web-Verzeichnisses."

#: src/PrivateUploads/StorageCheck.php:217
msgid "The folder for private event images cannot be written"
msgstr "Der Ordner für private Veranstaltungsbilder ist nicht beschreibbar"
